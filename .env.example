# Safe local default: no provider credentials or network model call required.
LLM_MODE=mock

# Set these values and switch LLM_MODE=deepseek to enable the provider.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

FOOTOPS_AGENT_MAX_ITERS=3
FOOTOPS_INPUT_MAX_CHARS=4000
FOOTOPS_REQUEST_TIMEOUT_SECONDS=30
FOOTOPS_CORS_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173"]

# Public football data. Cached responses are written below data/cache/ and ignored by Git.
STATSBOMB_OPEN_DATA_BASE_URL=https://raw.githubusercontent.com/hudl/open-data/master/data
FOOTOPS_DATA_CACHE_DIR=data/cache/statsbomb-open
FOOTOPS_DATA_TIMEOUT_SECONDS=20
