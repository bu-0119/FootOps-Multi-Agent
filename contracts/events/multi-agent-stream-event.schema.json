{
  "$defs": {
    "AgentModelUsage": {
      "additionalProperties": false,
      "description": "Provider-reported token usage and optional configured cost estimate.",
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "pricing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pricing Basis"
        }
      },
      "title": "AgentModelUsage",
      "type": "object"
    },
    "AgentToolTrace": {
      "additionalProperties": false,
      "description": "Auditable business-level trace without exposing model reasoning.",
      "properties": {
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "not_found",
            "insufficient",
            "unsupported",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "tool_name",
        "status",
        "summary"
      ],
      "title": "AgentToolTrace",
      "type": "object"
    },
    "AnalysisRequestArtifact": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/AnalysisScope"
        }
      },
      "required": [
        "question",
        "scope"
      ],
      "title": "AnalysisRequestArtifact",
      "type": "object"
    },
    "AnalysisScope": {
      "additionalProperties": false,
      "properties": {
        "competition_id": {
          "exclusiveMinimum": 0,
          "title": "Competition Id",
          "type": "integer"
        },
        "season_id": {
          "exclusiveMinimum": 0,
          "title": "Season Id",
          "type": "integer"
        },
        "player": {
          "minLength": 1,
          "title": "Player",
          "type": "string"
        },
        "player_id": {
          "exclusiveMinimum": 0,
          "title": "Player Id",
          "type": "integer"
        },
        "team": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Team"
        },
        "match_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Match Ids",
          "type": "array"
        }
      },
      "required": [
        "competition_id",
        "season_id",
        "player",
        "player_id",
        "match_ids"
      ],
      "title": "AnalysisScope",
      "type": "object"
    },
    "AnalysisWorkspace": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/WorkspaceStatus",
          "default": "created"
        },
        "request": {
          "$ref": "#/$defs/AnalysisRequestArtifact"
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageAuditArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlayerRoleMetricArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/FindingArtifact"
          },
          "title": "Findings",
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceSetArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceReviewArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tactics_board": {
          "anyOf": [
            {
              "$ref": "#/$defs/TacticsBoardArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "request"
      ],
      "title": "AnalysisWorkspace",
      "type": "object"
    },
    "BoardPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 100,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "BoardPoint",
      "type": "object"
    },
    "CompetitionSeason": {
      "additionalProperties": false,
      "properties": {
        "competition_id": {
          "title": "Competition Id",
          "type": "integer"
        },
        "season_id": {
          "title": "Season Id",
          "type": "integer"
        },
        "country_name": {
          "title": "Country Name",
          "type": "string"
        },
        "competition_name": {
          "title": "Competition Name",
          "type": "string"
        },
        "season_name": {
          "title": "Season Name",
          "type": "string"
        }
      },
      "required": [
        "competition_id",
        "season_id",
        "country_name",
        "competition_name",
        "season_name"
      ],
      "title": "CompetitionSeason",
      "type": "object"
    },
    "CoverageAuditArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "query": {
          "title": "Query",
          "type": "string"
        },
        "competition": {
          "$ref": "#/$defs/CompetitionSeason"
        },
        "matches_scanned": {
          "title": "Matches Scanned",
          "type": "integer"
        },
        "appearances": {
          "items": {
            "$ref": "#/$defs/PlayerMatchCoverage"
          },
          "title": "Appearances",
          "type": "array"
        },
        "requested_window": {
          "maximum": 10,
          "minimum": 2,
          "title": "Requested Window",
          "type": "integer"
        },
        "suggested_match_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 10,
          "title": "Suggested Match Ids",
          "type": "array"
        },
        "meets_minimum": {
          "title": "Meets Minimum",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "source",
        "query",
        "competition",
        "matches_scanned",
        "requested_window",
        "meets_minimum"
      ],
      "title": "CoverageAuditArtifact",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "metric"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "match_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Id"
        },
        "metric_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Name"
        },
        "metric_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Value"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "detail"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "EvidenceReviewArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "gate_version": {
          "const": "footops-evidence-gate-v1",
          "default": "footops-evidence-gate-v1",
          "title": "Gate Version",
          "type": "string"
        },
        "overall_status": {
          "enum": [
            "passed",
            "partial",
            "rejected"
          ],
          "title": "Overall Status",
          "type": "string"
        },
        "support_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Support Rate",
          "type": "number"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/FindingEvidenceReview"
          },
          "minItems": 1,
          "title": "Reviews",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "overall_status",
        "support_rate",
        "reviews"
      ],
      "title": "EvidenceReviewArtifact",
      "type": "object"
    },
    "EvidenceSetArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "references"
      ],
      "title": "EvidenceSetArtifact",
      "type": "object"
    },
    "ExecutionPlanArtifact": {
      "additionalProperties": false,
      "description": "Declare independent data, knowledge, and orchestration requirements.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "intent": {
          "enum": [
            "chat",
            "rule_qa",
            "tactical_knowledge",
            "metric_knowledge",
            "data_analysis",
            "hybrid_tactical_analysis"
          ],
          "title": "Intent",
          "type": "string"
        },
        "need_match_data": {
          "default": false,
          "title": "Need Match Data",
          "type": "boolean"
        },
        "need_rule_rag": {
          "default": false,
          "title": "Need Rule Rag",
          "type": "boolean"
        },
        "need_tactical_rag": {
          "default": false,
          "title": "Need Tactical Rag",
          "type": "boolean"
        },
        "need_metric_rag": {
          "default": false,
          "title": "Need Metric Rag",
          "type": "boolean"
        },
        "need_multi_agent": {
          "default": false,
          "title": "Need Multi Agent",
          "type": "boolean"
        },
        "scope_required": {
          "default": false,
          "title": "Scope Required",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "confidence",
        "reason"
      ],
      "title": "ExecutionPlanArtifact",
      "type": "object"
    },
    "FindingArtifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "descriptive",
            "inference"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "metric_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Metric Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "time_range": {
          "$ref": "#/$defs/FindingTimeRange"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease",
            "stable"
          ],
          "title": "Direction",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "statement",
        "claim_type",
        "metric_refs",
        "source_refs",
        "time_range",
        "direction",
        "confidence"
      ],
      "title": "FindingArtifact",
      "type": "object"
    },
    "FindingEvidenceReview": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "needs_more_evidence",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "accepted_metric_refs": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Metric Refs",
          "type": "array"
        },
        "accepted_source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Accepted Source Refs",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "status"
      ],
      "title": "FindingEvidenceReview",
      "type": "object"
    },
    "FindingTimeRange": {
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "match_ids": {
          "items": {
            "type": "integer"
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Match Ids",
          "type": "array"
        }
      },
      "required": [
        "start_date",
        "end_date",
        "match_ids"
      ],
      "title": "FindingTimeRange",
      "type": "object"
    },
    "MatchRef": {
      "additionalProperties": false,
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "integer"
        },
        "match_date": {
          "format": "date",
          "title": "Match Date",
          "type": "string"
        },
        "competition": {
          "$ref": "#/$defs/CompetitionSeason"
        },
        "home_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "away_team": {
          "$ref": "#/$defs/TeamRef"
        },
        "home_score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Score"
        },
        "away_score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Away Score"
        }
      },
      "required": [
        "match_id",
        "match_date",
        "competition",
        "home_team",
        "away_team"
      ],
      "title": "MatchRef",
      "type": "object"
    },
    "MatchRoleMetrics": {
      "additionalProperties": false,
      "properties": {
        "match_id": {
          "title": "Match Id",
          "type": "integer"
        },
        "match_date": {
          "format": "date",
          "title": "Match Date",
          "type": "string"
        },
        "event_count": {
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "touch_event_count": {
          "minimum": 0,
          "title": "Touch Event Count",
          "type": "integer"
        },
        "average_touch_x": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Touch X"
        },
        "average_touch_y": {
          "anyOf": [
            {
              "maximum": 80,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Touch Y"
        },
        "attacking_third_touch_count": {
          "minimum": 0,
          "title": "Attacking Third Touch Count",
          "type": "integer"
        },
        "attacking_third_touch_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attacking Third Touch Ratio"
        },
        "penalty_area_touch_count": {
          "minimum": 0,
          "title": "Penalty Area Touch Count",
          "type": "integer"
        },
        "penalty_area_touch_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Penalty Area Touch Ratio"
        },
        "receipt_count": {
          "minimum": 0,
          "title": "Receipt Count",
          "type": "integer"
        },
        "average_receipt_x": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Receipt X"
        },
        "forward_pass_count": {
          "minimum": 0,
          "title": "Forward Pass Count",
          "type": "integer"
        },
        "completed_forward_pass_count": {
          "minimum": 0,
          "title": "Completed Forward Pass Count",
          "type": "integer"
        },
        "progressive_carry_count": {
          "minimum": 0,
          "title": "Progressive Carry Count",
          "type": "integer"
        },
        "key_pass_count": {
          "minimum": 0,
          "title": "Key Pass Count",
          "type": "integer"
        },
        "shot_count": {
          "minimum": 0,
          "title": "Shot Count",
          "type": "integer"
        },
        "shot_involvement_count": {
          "minimum": 0,
          "title": "Shot Involvement Count",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "match_date",
        "event_count",
        "touch_event_count",
        "attacking_third_touch_count",
        "penalty_area_touch_count",
        "receipt_count",
        "forward_pass_count",
        "completed_forward_pass_count",
        "progressive_carry_count",
        "key_pass_count",
        "shot_count",
        "shot_involvement_count"
      ],
      "title": "MatchRoleMetrics",
      "type": "object"
    },
    "MultiAgentRunResponse": {
      "additionalProperties": false,
      "description": "Natural-language ScopeAgent result and optional multi-agent workspace.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "clarification_required",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "runtime": {
          "const": "footops_event_driven_multi_agent_v1",
          "default": "footops_event_driven_multi_agent_v1",
          "title": "Runtime",
          "type": "string"
        },
        "provider": {
          "const": "statsbomb-open-data",
          "default": "statsbomb-open-data",
          "title": "Provider",
          "type": "string"
        },
        "model_called": {
          "title": "Model Called",
          "type": "boolean"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "execution_plan": {
          "$ref": "#/$defs/ExecutionPlanArtifact"
        },
        "scope": {
