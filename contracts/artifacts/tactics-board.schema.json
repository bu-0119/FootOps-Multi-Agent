{
  "$defs": {
    "BoardPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 100,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "BoardPoint",
      "type": "object"
    },
    "TacticsAnnotation": {
      "additionalProperties": false,
      "properties": {
        "annotation_id": {
          "title": "Annotation Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "finding_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Refs",
          "type": "array"
        }
      },
      "required": [
        "annotation_id",
        "text",
        "finding_refs"
      ],
      "title": "TacticsAnnotation",
      "type": "object"
    },
    "TacticsArrow": {
      "additionalProperties": false,
      "properties": {
        "arrow_id": {
          "title": "Arrow Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "movement",
            "passing"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/BoardPoint"
        },
        "end": {
          "$ref": "#/$defs/BoardPoint"
        },
        "finding_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Refs",
          "type": "array"
        }
      },
      "required": [
        "arrow_id",
        "label",
        "kind",
        "start",
        "end",
        "finding_refs"
      ],
      "title": "TacticsArrow",
      "type": "object"
    },
    "TacticsPlayerMarker": {
      "additionalProperties": false,
      "properties": {
        "marker_id": {
          "title": "Marker Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "display_label": {
          "maxLength": 3,
          "minLength": 1,
          "title": "Display Label",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/BoardPoint"
        },
        "role": {
          "default": "focus",
          "enum": [
            "focus",
            "teammate",
            "opponent"
          ],
          "title": "Role",
          "type": "string"
        },
        "finding_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Refs",
          "type": "array"
        }
      },
      "required": [
        "marker_id",
        "label",
        "display_label",
        "position",
        "finding_refs"
      ],
      "title": "TacticsPlayerMarker",
      "type": "object"
    },
    "TacticsZone": {
      "additionalProperties": false,
      "properties": {
        "zone_id": {
          "title": "Zone Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "touch_area",
            "attacking_third"
          ],
          "title": "Kind",
          "type": "string"
        },
        "x": {
          "maximum": 100,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 100,
          "title": "Height",
          "type": "number"
        },
        "finding_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Finding Refs",
          "type": "array"
        }
      },
      "required": [
        "zone_id",
        "label",
        "kind",
        "x",
        "y",
        "width",
        "height",
        "finding_refs"
      ],
      "title": "TacticsZone",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generator": {
      "const": "footops-deterministic-tactics-v1",
      "default": "footops-deterministic-tactics-v1",
      "title": "Generator",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "pitch_orientation": {
      "const": "vertical_attacking_up",
      "default": "vertical_attacking_up",
      "title": "Pitch Orientation",
      "type": "string"
    },
    "formation": {
      "default": "unassigned",
      "enum": [
        "unassigned",
        "4-3-3",
        "4-2-3-1",
        "3-4-3"
      ],
      "title": "Formation",
      "type": "string"
    },
    "players": {
      "items": {
        "$ref": "#/$defs/TacticsPlayerMarker"
      },
      "title": "Players",
      "type": "array"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/TacticsZone"
      },
      "title": "Zones",
      "type": "array"
    },
    "arrows": {
      "items": {
        "$ref": "#/$defs/TacticsArrow"
      },
      "title": "Arrows",
      "type": "array"
    },
    "passing_lanes": {
      "items": {
        "$ref": "#/$defs/TacticsArrow"
      },
      "title": "Passing Lanes",
      "type": "array"
    },
    "annotations": {
      "items": {
        "$ref": "#/$defs/TacticsAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "finding_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Finding Refs",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "title",
    "finding_refs",
    "evidence_refs"
  ],
  "title": "TacticsBoardArtifact",
  "type": "object"
}
